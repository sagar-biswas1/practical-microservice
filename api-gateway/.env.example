NODE_ENV=development
PORT=4000
HOST=0.0.0.0
SERVICE_NAME=api-gateway
LOG_LEVEL=debug

# Upstreams. The gateway is stateless — it owns no database.
PRODUCT_SERVICE_URL=http://localhost:4001
INVENTORY_SERVICE_URL=http://localhost:4002
USER_SERVICE_URL=http://localhost:4003
EMAIL_SERVICE_URL=http://localhost:4004
AUTH_SERVICE_URL=http://localhost:4005

# Must match the auth service's JWT_SECRET/ISSUER/AUDIENCE byte for byte — the
# gateway verifies access tokens itself rather than calling the auth service,
# so a mismatch makes every valid token look forged. Required: without it the
# edge policies would have no way to fail closed.
JWT_SECRET=
JWT_ISSUER=auth-service
JWT_AUDIENCE=practical-microservice

# Must exceed the product service's INVENTORY_TIMEOUT_MS (3000), otherwise the
# gateway cuts off calls that service is still legitimately waiting on.
PROXY_TIMEOUT_MS=15000
HEALTH_TIMEOUT_MS=2000

# Per-IP throttle on proxied traffic. In-memory, so the ceiling is per replica.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# A tighter, shared bucket for the credential endpoints (login, register,
# refresh, password reset, verification). One budget across all of them, so
# rotating between endpoints does not buy a fresh allowance.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Forward a client-supplied x-actor-id instead of dropping it. Local testing
# only: on an unauthenticated route the header is an unverified claim, and
# downstream audit logs would attribute writes to whoever asked. On routes the
# edge authenticates, the verified token wins regardless of this setting.
TRUST_CLIENT_ACTOR=false

# Whether X-Forwarded-For is believed, which decides what req.ip — the rate
# limiter's key — resolves to. `loopback`, a hop count like `1`, a subnet, or
# `false`. Avoid `true`: it lets any client forge the header and reset its own
# rate-limit bucket. Set it to the number of proxies actually in front of this.
TRUST_PROXY=loopback

# Serves /docs (Swagger UI) and /openapi.json. The document is generated from
# the same Zod schemas the routes validate with, so it cannot go stale. Turn it
# off where this service's surface should not be enumerable.
DOCS_ENABLED=true

# Comma-separated list, or * to allow all origins.
CORS_ORIGINS=*
MAX_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000
