NODE_ENV=development
PORT=4000
HOST=0.0.0.0
SERVICE_NAME=api-gateway
LOG_LEVEL=debug

# Upstreams. The gateway is stateless — it owns no database.
PRODUCT_SERVICE_URL=http://localhost:4001
INVENTORY_SERVICE_URL=http://localhost:4002
USER_SERVICE_URL=http://localhost:4003

# Must exceed the product service's INVENTORY_TIMEOUT_MS (3000), otherwise the
# gateway cuts off calls that service is still legitimately waiting on.
PROXY_TIMEOUT_MS=15000
HEALTH_TIMEOUT_MS=2000

# Per-IP throttle on proxied traffic. In-memory, so the ceiling is per replica.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Forward a client-supplied x-actor-id instead of dropping it. Local testing
# only: until authentication lands here, the header is an unverified claim and
# downstream audit logs would attribute writes to whoever asked.
TRUST_CLIENT_ACTOR=false

# Whether X-Forwarded-For is believed, which decides what req.ip — the rate
# limiter's key — resolves to. `loopback`, a hop count like `1`, a subnet, or
# `false`. Avoid `true`: it lets any client forge the header and reset its own
# rate-limit bucket. Set it to the number of proxies actually in front of this.
TRUST_PROXY=loopback

# Comma-separated list, or * to allow all origins.
CORS_ORIGINS=*
MAX_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000
