{
  "name": "practical-microservice",
  "version": "1.0.0",
  "private": true,
  "description": "Practical microservices playground: product + inventory services",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "start:all": "bash scripts/start-all.sh",
    "build": "pnpm -r build",
    "start": "pnpm -r --parallel start",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r --parallel test:watch",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm -r db:generate",
    "db:migrate": "pnpm -r db:migrate",
    "db:push": "pnpm -r db:push",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "redis:logs": "docker compose logs -f redis",
    "redis:cli": "docker compose exec redis redis-cli",
    "rabbitmq:up": "docker compose up -d rabbitmq",
    "rabbitmq:logs": "docker compose logs -f rabbitmq",
    "rabbitmq:cli": "docker compose exec rabbitmq rabbitmqctl",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache && rm -rf node_modules"
  }
}
