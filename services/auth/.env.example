NODE_ENV=development
PORT=4005
HOST=0.0.0.0
SERVICE_NAME=auth-service
LOG_LEVEL=debug

# Auth service owns the `auth` Postgres schema.
# DATABASE_URL is what the running service connects with — point it at the
# connection pooler if your provider has one.
DATABASE_URL=postgresql://user:password@localhost:5432/practical_microservice?schema=auth
# DIRECT_URL must be an unpooled connection; `prisma migrate` uses it instead of
# DATABASE_URL. With a plain local Postgres the two are identical.
DIRECT_URL=postgresql://user:password@localhost:5432/practical_microservice?schema=auth

# Comma-separated list, or * to allow all origins.
CORS_ORIGINS=*
BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# ---- Access tokens ----------------------------------------------------------
# REQUIRED, no default, in every environment. The service refuses to boot
# without it — a fallback would mean a deploy that forgot to set it would come
# up healthy and sign real tokens with a key that is public knowledge.
# Left deliberately empty: it fails the minimum-length check, so copying this
# file and forgetting this line stops the service at boot with a readable error
# instead of quietly signing tokens with a placeholder committed to the repo.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Written to iss/aud and checked on every verification, so a token minted by a
# different environment sharing the same secret is still rejected here.
JWT_ISSUER=auth-service
JWT_AUDIENCE=practical-microservice

# Access tokens are not revocable — verifying one touches no database. This
# value is therefore exactly how long a stolen token keeps working, so keep it
# short and let the refresh token carry the long-lived authority.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- Password hashing -------------------------------------------------------
# OWASP's second recommended argon2id configuration (19 MiB, t=2, p=1).
# Raising these needs no migration: the parameters are encoded in each stored
# digest, so existing hashes keep verifying under the settings they were made
# with. Lower them for CI if hashing dominates your test runtime.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Length is the control that matters (NIST SP 800-63B); composition rules
# mostly produce `Password1!`. The max exists to bound hashing cost.
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128

# ---- Verification codes -----------------------------------------------------
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
# Without a cooldown, "resend code" is an open relay for mailing an address as
# fast as HTTP allows.
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ---- Lockout ----------------------------------------------------------------
MAX_FAILED_LOGIN_ATTEMPTS=5
# Time-bounded, not permanent: a lock only an operator can clear lets anyone
# who knows an email address lock its owner out on demand.
ACCOUNT_LOCK_DURATION_MINUTES=15

# ---- Retention sweep --------------------------------------------------------
# Nothing on the request path ever deletes a refresh token, and rotation writes
# one on every refresh — roughly 96 a day per active client with a 15-minute
# access token. The reaper is what keeps that table from growing forever.
#
# Set REAPER_ENABLED=false on the API instances if a scheduler runs the sweep
# instead (`pnpm --filter @services/auth reap`). Same policy either way.
REAPER_ENABLED=true
REAPER_INTERVAL_MS=3600000
# Rows per table per sweep. Bounded so the first run against a never-swept
# table cannot lock up the pool serving logins; it catches up over cycles.
REAPER_BATCH_SIZE=5000

# Past its expiry a token can never be accepted again, so this grace only keeps
# the recent past readable while debugging.
REFRESH_TOKEN_EXPIRED_GRACE_DAYS=1
# Longer than the grace above, deliberately. A REUSE_DETECTED family is the
# only record this service keeps that a session was stolen, and that
# investigation rarely starts the same day. Must be >= the grace.
REFRESH_TOKEN_REVOKED_RETENTION_DAYS=30
# Settled codes only — a PENDING one is live state and is never swept. 0 disables.
VERIFICATION_RETENTION_DAYS=7
# The audit trail, so kept far longer. 0 disables, for deployments whose
# retention rules are set somewhere other than this file.
LOGIN_HISTORY_RETENTION_DAYS=180

# ---- Downstream services ----------------------------------------------------
# Auth enqueues mail here and creates the profile there. Both are called
# outside the database transaction — see the notes in auth.service.ts.
EMAIL_SERVICE_URL=http://localhost:4004
EMAIL_TIMEOUT_MS=3000
USER_SERVICE_URL=http://localhost:4003
USER_TIMEOUT_MS=3000

# ---- Outbound mail content --------------------------------------------------
APP_NAME=Practical Microservice
