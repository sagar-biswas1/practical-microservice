NODE_ENV=development
PORT=4002
HOST=0.0.0.0
SERVICE_NAME=inventory-service
LOG_LEVEL=debug

# Inventory service owns the `inventory` Postgres schema.
# DATABASE_URL is what the running service connects with — point it at the
# connection pooler if your provider has one.
DATABASE_URL=postgresql://user:password@localhost:5432/practical_microservice?schema=inventory
# DIRECT_URL must be an unpooled connection; `prisma migrate` uses it instead of
# DATABASE_URL. With a plain local Postgres the two are identical.
DIRECT_URL=postgresql://user:password@localhost:5432/practical_microservice?schema=inventory

# Serves /docs (Swagger UI) and /openapi.json. The document is generated from
# the same Zod schemas the routes validate with, so it cannot go stale. Turn it
# off where this service's surface should not be enumerable.
DOCS_ENABLED=true

# Comma-separated list, or * to allow all origins.
CORS_ORIGINS=*
BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# RabbitMQ. Setting RABBITMQ_URL starts the stock-event consumer: the service
# connects at boot, declares the `inventory` exchange and the `inventory.stock`
# queue, and applies releases published by the cart. It refuses to start if the
# broker is unreachable. Leave it unset to run on HTTP alone.
# `pnpm rabbitmq:up` at the repo root starts a broker matching this URL.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# RABBITMQ_PREFETCH=10
# RABBITMQ_HEARTBEAT_SECONDS=30
# RABBITMQ_CONNECT_TIMEOUT_MS=10000
# RABBITMQ_MAX_RETRY_DELAY_MS=5000
# RABBITMQ_REQUEUE_DELAY_MS=1000
