NODE_ENV=development
PORT=4004
HOST=0.0.0.0
SERVICE_NAME=email-service
LOG_LEVEL=debug

# Email service owns the `email` Postgres schema.
# DATABASE_URL is what the running service connects with — point it at the
# connection pooler if your provider has one.
DATABASE_URL=postgresql://user:password@localhost:5432/practical_microservice?schema=email
# DIRECT_URL must be an unpooled connection; `prisma migrate` uses it instead of
# DATABASE_URL. With a plain local Postgres the two are identical.
DIRECT_URL=postgresql://user:password@localhost:5432/practical_microservice?schema=email

# Serves /docs (Swagger UI) and /openapi.json. The document is generated from
# the same Zod schemas the routes validate with, so it cannot go stale. Turn it
# off where this service's surface should not be enumerable.
DOCS_ENABLED=true

# Comma-separated list, or * to allow all origins.
CORS_ORIGINS=*
# Bigger than the other services: an HTML body is the payload here.
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# ---- Provider ---------------------------------------------------------------
# `console` logs the message instead of sending it and needs no credentials —
# the right choice for local work. Switch to `resend` and set RESEND_API_KEY to
# send for real. Adding another provider means adding a case in
# src/providers/index.ts; nothing else in the service names a provider.
EMAIL_PROVIDER=console
# Resend rejects any sender domain you have not verified. `onboarding@resend.dev`
# is their sandbox sender and only delivers to your own account address.
EMAIL_FROM=onboarding@resend.dev
EMAIL_PROVIDER_TIMEOUT_MS=10000
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_BASE_URL=https://api.resend.com

# ---- Message limits ---------------------------------------------------------
EMAIL_MAX_BODY_CHARS=100000
EMAIL_MAX_ATTEMPTS=5

# ---- Dispatcher -------------------------------------------------------------
# false = the API only writes to the outbox; run `pnpm dispatch` separately.
DISPATCHER_ENABLED=true
DISPATCHER_POLL_INTERVAL_MS=5000
DISPATCHER_BATCH_SIZE=25
DISPATCHER_CONCURRENCY=5
# Must exceed EMAIL_PROVIDER_TIMEOUT_MS, or a slow send can be reclaimed by
# another worker while it is still in flight and delivered twice.
DISPATCHER_CLAIM_TIMEOUT_MS=120000

# Retry delay doubles per attempt (2s, 4s, 8s, …) with jitter, capped here.
RETRY_BACKOFF_BASE_MS=2000
RETRY_BACKOFF_MAX_MS=900000

# Delete SENT messages older than this. 0 disables the purge.
EMAIL_RETENTION_DAYS=30
