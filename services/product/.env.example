NODE_ENV=development
PORT=4001
HOST=0.0.0.0
SERVICE_NAME=product-service
LOG_LEVEL=debug

# Product service owns the `product` Postgres schema.
# DATABASE_URL is what the running service connects with — point it at the
# connection pooler if your provider has one.
DATABASE_URL=postgresql://user:password@localhost:5432/practical_microservice?schema=product
# DIRECT_URL must be an unpooled connection; `prisma migrate` uses it instead of
# DATABASE_URL. With a plain local Postgres the two are identical.
DIRECT_URL=postgresql://user:password@localhost:5432/practical_microservice?schema=product

# Comma-separated list, or * to allow all origins.
CORS_ORIGINS=*
BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# Downstream services
INVENTORY_SERVICE_URL=http://localhost:4002
INVENTORY_TIMEOUT_MS=3000
