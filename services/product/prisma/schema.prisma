// Product service owns this schema exclusively.
// Database-per-service is emulated with a dedicated Postgres schema:
// DATABASE_URL=postgresql://.../db?schema=product
//
// There is deliberately no `inventoryId` here. Stock lives in the inventory
// service, keyed by `productId`; a second reference pointing back would make
// the two rows mutually dependent — neither could be written first — and give
// the same relationship two sources of truth that can disagree.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

// `url` is the pooled endpoint the running service uses. `directUrl` is the
// unpooled one, used only by migrate/introspect: the migration engine needs a
// stable session (its `search_path` sets the schema above, and it creates a
// shadow database), and a transaction pooler hands out a different backend
// mid-run, which loses both.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sku         String        @unique @db.VarChar(64)
  name        String        @db.VarChar(200)
  description String?       @db.Text
  priceCents  Int           @map("price_cents")
  currency    String        @default("USD") @db.Char(3)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("products")
}
