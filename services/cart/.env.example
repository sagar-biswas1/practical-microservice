# Root-level defaults. Each service also reads its own services/<name>/.env,
# which takes precedence. Never commit the real .env.
DATABASE_URL=postgresql://user:password@localhost:5432/practical_microservice
PORT=4006

# Redis: set REDIS_URL, or leave it unset and fill in the discrete fields.
# rediss:// selects TLS on its own; REDIS_TLS is for the discrete form.
REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false
# Namespaces every key this service writes.
REDIS_KEY_PREFIX=cart:

# Inventory service, called directly (not through the gateway).
INVENTORY_SERVICE_URL=http://localhost:4002
INVENTORY_TIMEOUT_MS=5000

# RabbitMQ. Setting RABBITMQ_URL turns messaging on: the service connects at
# boot and refuses to start if it cannot. Leave it unset to run without a
# broker. `pnpm rabbitmq:up` at the repo root starts one matching this URL;
# the management UI is at http://localhost:15672 (guest / guest).
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# RABBITMQ_HEARTBEAT_SECONDS=30
# RABBITMQ_CONNECT_TIMEOUT_MS=10000
# RABBITMQ_MAX_RETRY_DELAY_MS=5000
# RABBITMQ_PUBLISH_TIMEOUT_MS=5000

# How the fire-and-forget half of the inventory contract (stock releases)
# travels: `http` calls inventory directly, `amqp` publishes to the
# `inventory` exchange and needs RABBITMQ_URL plus a consumer on the
# inventory side. Reservations always go over HTTP either way.
INVENTORY_DISPATCH_TRANSPORT=http
