# Root-level defaults. Each service also reads its own services/<name>/.env,
# which takes precedence. Never commit the real .env.
DATABASE_URL=postgresql://user:password@localhost:5432/practical_microservice
PORT=4006

# Redis: set REDIS_URL, or leave it unset and fill in the discrete fields.
# rediss:// selects TLS on its own; REDIS_TLS is for the discrete form.
REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false
# Namespaces every key this service writes.
REDIS_KEY_PREFIX=cart:
